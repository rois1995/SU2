SU2Source.source_real_update {d : Nat} (U delta : SU2.State d) (alpha : Real) (channel : SU2.Channel d)
  (layout : SU2Source.Layout) (point component : Nat) (memory : SU2Source.Memory Real) (dest source : SU2Source.Address)
  (hd :
    Eq.{1}
      (SU2Source.address layout
        { point := point, component := component, increment := HMul.hMul.{0, 0, 0} alpha (delta channel) }
        SU2Source.currentCell)
      (some.{0} dest))
  (hs :
    Eq.{1}
      (SU2Source.address layout
        { point := point, component := component, increment := HMul.hMul.{0, 0, 0} alpha (delta channel) }
        SU2Source.oldCell)
      (some.{0} source))
  (hx : Eq.{1} (memory source) (some.{0} (U channel))) :
  ∃ after,
    And
      (Eq.{1}
        (SU2Source.execute SU2Source.realOperations layout
          { point := point, component := component, increment := HMul.hMul.{0, 0, 0} alpha (delta channel) }
          SU2Source.Generated.originalProgram memory)
        (some.{0} after))
      (And (Eq.{1} (after dest) (some.{0} (SU2.conservativeUpdate U delta alpha channel)))
        (∀ (other : SU2Source.Address), Ne.{1} other dest → Eq.{1} (after other) (memory other)))
