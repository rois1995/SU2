SU2Euler.composed_source_cell {N d : Nat} (volumes : Fin N → SU2.ControlVolume d) (dt : Fin N → Real)
  (old initial trunc : SU2.Residual N d) (lanes : List.{0} (SU2Euler.Lane N d))
  (finish : SU2.Residual N d → SU2.Residual N d) (i : Fin N) (c : SU2.Channel d) (memory : SU2Source.Memory Real)
  (size :
    LE.le.{0} (HMul.hMul.{0, 0, 0} 8 (HMul.hMul.{0, 0, 0} N (HAdd.hAdd.{0, 0, 0} d 2))) (HPow.hPow.{0, 0, 0} 2 64))
  (initialized :
    Eq.{1}
      (memory
        (Prod.mk.{0, 0} 1
          (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑i) (HAdd.hAdd.{0, 0, 0} d 2)) (SU2Euler.componentIndex c))))
      (some.{0} (old i c))) :
  let R := finish (SU2Euler.scatterLoop SU2Euler.Generated.scatter_originalCode lanes initial);
  let increment :=
    HMul.hMul.{0, 0, 0} (Neg.neg.{0} (SU2Euler.opReal SU2Euler.Generated.apply_originalCode (R i c) (trunc i c)))
      (HDiv.hDiv.{0, 0, 0} (dt i) (HAdd.hAdd.{0, 0, 0} (SU2.ControlVolume.measure (volumes i)) 0));
  ∃ after,
    And
      (Eq.{1}
        (SU2Source.execute SU2Source.realOperations (SU2Euler.stateLayout N d)
          { point := ↑i, component := SU2Euler.componentIndex c, increment := increment }
          SU2Euler.Generated.update_originalCode memory)
        (some.{0} after))
      (And
        (Eq.{1}
          (after
            (Prod.mk.{0, 0} 0
              (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑i) (HAdd.hAdd.{0, 0, 0} d 2)) (SU2Euler.componentIndex c))))
          (some.{0} (SU2Euler.stepSpec volumes dt old initial trunc (SU2Euler.activeEvents lanes) finish i c)))
        (∀ (other : Prod.{0, 0} Nat Nat),
          Ne.{1} other
              (Prod.mk.{0, 0} 0
                (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑i) (HAdd.hAdd.{0, 0, 0} d 2))
                  (SU2Euler.componentIndex c))) →
