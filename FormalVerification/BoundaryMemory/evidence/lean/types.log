  (bounds : SU2BoundaryMemory.Bounds M M K vertices) (g : SU2.IdealGas) (free : SU2.Primitive 2)
  (P : SU2BoundaryMemory.Primitives M) (far : List.{0} (SU2BoundaryMemory.FarSite M K vertices))
  (walls : List.{0} (SU2Boundary.WallVisit M)) (s0 : SU2Boundary.BoundaryState M) (m0 : SU2BoundaryMemory.Mem)
  (vol dt : Fin M → Real) (h0 : SU2BoundaryMemory.BoundaryRep vertices m0 s0 P)
  (hg0 : SU2BoundaryMemory.GeometryRep m0 vol (fun x => 0) dt)
  (farReady : SU2Boundary.FarReady g free (List.map.{0, 0} (SU2BoundaryMemory.farVisit P) far)) :
  let sb := SU2Boundary.boundarySpec g free (List.map.{0, 0} (SU2BoundaryMemory.farVisit P) far) walls s0;
  let so := SU2BoundaryMemory.ownedState owned sb;
  let vo := fun p => vol (Fin.castLE owned p);
  let dto := fun p => dt (Fin.castLE owned p);
  ∃ mb mu,
    And (Eq.{1} (SU2BoundaryMemory.executeSourceBoundary M g free far walls m0) (some.{0} mb))
      (And (SU2BoundaryMemory.BoundaryRep vertices mb sb P)
        (And (SU2Boundary.InputsReady mb so vo (fun x => 0) dto)
          (And
            (Eq.{1}
              (SU2Boundary.executeLoop M SU2Boundary.Generated.volume_original SU2Boundary.Generated.periodic_original
                SU2Boundary.Generated.timestep_original SU2Boundary.Generated.points_original
                SU2Boundary.Generated.components_original mb)
              (some.{0} mu))
            (And (SU2Boundary.LoopContract so vo dto mb mu)
              (SU2BoundaryMemory.Frame
                (HAppend.hAppend.{0, 0, 0} (SU2BoundaryMemory.boundaryFootprint far walls)
                  (List.map.{0, 0} SU2Boundary.destination (SU2Boundary.visits N)))
                m0 mu)))))
