SU2Source.scalarUpdateIR_exec {α : Type} (ops : SU2Source.Operations α) (layout : SU2Source.Layout)
  (args : SU2Source.Inputs α) (memory : SU2Source.Memory α) (dest source : SU2Source.Address) (x : α)
  (hd : SU2Source.address layout args SU2Source.currentCell = some dest)
  (hs : SU2Source.address layout args SU2Source.oldCell = some source) (hx : memory source = some x) :
  SU2Source.execute ops layout args SU2Source.scalarUpdateIR memory =
    some (Function.update memory dest (some (ops.add x args.increment)))
