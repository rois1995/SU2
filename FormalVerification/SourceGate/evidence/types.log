SU2Source.source_real_update {d : ℕ} (U delta : SU2.State d) (alpha : ℝ) (channel : SU2.Channel d)
  (layout : SU2Source.Layout) (point component : ℕ) (memory : SU2Source.Memory ℝ) (dest source : SU2Source.Address)
  (hd :
    SU2Source.address layout { point := point, component := component, increment := alpha * delta channel }
        SU2Source.currentCell =
      some dest)
  (hs :
    SU2Source.address layout { point := point, component := component, increment := alpha * delta channel }
        SU2Source.oldCell =
      some source)
  (hx : memory source = some (U channel)) :
  ∃ after,
    SU2Source.execute SU2Source.realOperations layout
          { point := point, component := component, increment := alpha * delta channel }
          SU2Source.Generated.originalProgram memory =
        some after ∧
      after dest = some (SU2.conservativeUpdate U delta alpha channel) ∧
        ∀ (other : SU2Source.Address), other ≠ dest → after other = memory other
'SU2Source.source_real_update' depends on axioms: [propext, Classical.choice, Quot.sound]
