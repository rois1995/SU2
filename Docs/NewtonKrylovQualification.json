      ],
      "tests": [
        "NewtonController",
        "NewtonFlowPolicy",
        "NewtonProduction"
      ],
      "status": "verified by inspected source and final qualification evidence"
    },
    {
      "number": 2,
      "title": "Selection and grouping",
      "finding": "Configuration validation is separate from coupled/segregated ownership. Native dispatch order differs from packing order; each selected equation has exactly one owner.",
