  "requirements": [
    {
      "number": 1,
      "title": "One common algorithm",
      "finding": "CNewtonIntegration owns Krylov, true-defect checks, Armijo, forcing, CFL recovery and diagnostics. CSSTNewtonIntegration is removed. CNewtonLegacyIntegration remains only for explicitly unmigrated execution modes.",
