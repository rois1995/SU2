+MetricMeasures Mesh::Shape(Vertices vertices) const {
+  SU2Native3D::Tetrahedron tet;
+  std::array<const Tensor*, 4> tensors;
+  for (unsigned k = 0; k < 4; ++k) {
+    tet[k] = points_[vertices[k]].node.p;
+    tensors[k] = &points_[vertices[k]].tensor;
