+unsigned WitnessAxis(const std::vector<Point>& points) {
+  if (points.empty()) return 0;
+  auto low = Values(points.front()), high = low;
+  for (const auto& point : points) {
+    const auto value = Values(point);
+    for (unsigned d = 0; d < 3; ++d) {
+      low[d] = std::min(low[d], value[d]);
+      high[d] = std::max(high[d], value[d]);
+    }
