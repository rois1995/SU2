+auto WitnessRange(const WitnessBorder& border, Point base, Point end, unsigned axis, double limit) {
+  const double a = Values(base)[axis], b = Values(end)[axis];
+  const auto [low, high] = std::minmax(a, b);
+  const double lo = std::nextafter(low - limit, -INFINITY);
+  const double hi = std::nextafter(high + limit, INFINITY);
+  const auto first = std::lower_bound(border.begin(), border.end(), lo,
+                                      [](const auto& entry, double value) { return entry.first < value; });
+  const auto last = std::upper_bound(first, border.end(), hi,
+                                     [](double value, const auto& entry) { return value < entry.first; });
+  return std::make_pair(first, last);
