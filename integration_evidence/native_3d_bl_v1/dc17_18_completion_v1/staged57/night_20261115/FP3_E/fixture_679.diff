+std::string StallProbe(const World& world) {
+  const auto* setting = std::getenv("SU2_NATIVE_FP3_PROBE");
+  REQUIRE(setting != nullptr);
+  std::cout << "FP3_E HIDDEN_PROBE rank=" << world.rank << " value=" << setting << '\n';
+  return setting;
+}
