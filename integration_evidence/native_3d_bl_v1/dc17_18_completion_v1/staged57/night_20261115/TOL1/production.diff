+      RejectFrozenSeam();
+  std::set<Edge> sides;
+  for (const auto& face : faces) for (unsigned k = 0; k < 3; ++k) {
+    const Id a = face.v[k], b = face.v[(k+1)%3];
+    if (!geometry->FrozenSeamEdge(points.at(a).binding, points.at(b).binding, mobility)) continue;
