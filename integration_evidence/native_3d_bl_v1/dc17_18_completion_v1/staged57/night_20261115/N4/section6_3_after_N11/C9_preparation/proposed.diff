+              throw std::runtime_error(star.reason);
+            }
+            ++stats.placement_classified_vertices;
+            if (trial_checks.MovableStar(star, candidates[i])) costs.emplace(candidates[i], star.cells.size());
+          }
+          apices = SplitPatchApices(old, choice.edge, &costs);
+          if (costs.count(initial_placement_obstruction)) {
+            // Admit an actual blocking star when the all-cell cover cannot fit, without raising the cavity bound.
+            const std::vector<Id> targeted{initial_placement_obstruction};
+            if ((apices.empty() || trial_checks.AdmittedCells(apices, candidates, payload) > MaximumCavityCells) &&
+                trial_checks.AdmittedCells(targeted, candidates, payload) <= MaximumCavityCells) {
+              apices = targeted;
+              ++stats.placement_dependency_expansions;
+            }
+          }
+          search = !apices.empty();
+        } catch (const std::exception& e) {
+          failure.Set(2, 0, e.what());
+        }
+    }
+  }
+  if (!(ready = context.exchange.Vote(context, failure))) return false;
+  for (unsigned attempt = 0; attempt < 8 && trial_comm.Maximum(search && !approved); ++attempt) {
+    placement_obstruction = UINT64_MAX;
+    if (!place_patch(search, apices)) return false;
+    bool expand = search && !approved && stats.global_work < stats.work_limit && apices.size() < 8 &&
+                  placement_obstruction != UINT64_MAX && placement_obstruction != choice.edge[0] &&
+                  placement_obstruction != choice.edge[1] &&
+                  std::find(apices.begin(), apices.end(), placement_obstruction) == apices.end();
+    if (!trial_comm.Maximum(expand)) break;
+    {
+      Timer timer(stats.dependency_seconds, options.timings, SU2NativeTiming3D::Operation::Topology);
+      const std::vector<Feature> hints =
+          expand ? std::vector<Feature>{{{{placement_obstruction, 0, 0}}, 1}} : std::vector<Feature>{};
+      auto metadata = directory->LookupBatch(
+          hints, options.memory_ceiling,
+          transfer_memory::Add(context.exchange.Bytes(context), source.ResidentBytes(), private_scratch));
+      if (!metadata.valid) {
+        result.reason = metadata.reason;
+        return false;
+      }
+      auto payload = directory->FetchBatch(
+          metadata, working, options.memory_ceiling,
+          transfer_memory::Add(context.exchange.Bytes(context), source.ResidentBytes(), private_scratch));
+      if (!payload.valid) {
+        result.reason = payload.reason;
+        return false;
+      }
+      if (expand) try {
+          const auto& star = payload.candidates.at(0);
+          if (!star.valid) {
+            if (star.reason == "Native 3D dependency star exceeds budget.")
+              expand = false;
+            else
+              throw std::runtime_error(star.reason);
+          } else {
+            ++stats.placement_classified_vertices;
+            expand = trial_checks.MovableStar(star, placement_obstruction);
+          }
+          if (expand) {
+            apices.push_back(placement_obstruction);
+            ++stats.placement_dependency_expansions;
+          }
+        } catch (const std::exception& e) {
+          failure.Set(2, 0, e.what());
+        }
+    }
+    if (!(ready = context.exchange.Vote(context, failure))) return false;
+    search = expand;
+  }
+  joint = joint && boundary_edge;
+  Tensor placement, nearPlacement;
+  if (trial_comm.Maximum(joint)) {
+    std::vector<Point> query;
+    if (joint) try {
+        if (std::none_of(old.cells.begin(), old.cells.end(), [&](const Cell& cell) {
+              unsigned matches = 0;
+              for (auto n : cell.v) matches += n.id == choice.edge[0] || n.id == choice.edge[1];
+              return matches == 2;
+            }))
+          throw std::runtime_error("Native3D joint patch lacks its complete split edge.");
+        query.push_back(Centroid(old.cells.front()));
+        if (!choice.geometric) query.push_back(point.p);
+      } catch (const std::exception& e) {
+        failure.Set(2, 0, e.what());
+      }
+    if (!(ready = context.exchange.Vote(context, failure))) return false;
+    DonorSamples proxy;
+    {
+      Timer timer(stats.donor_seconds, options.timings, SU2NativeTiming3D::Operation::Import);
+      ++stats.donor_batches;
+      proxy = trial_comm.SamplePoints(
+          query, eligible_extensions, options.memory_ceiling,
+          transfer_memory::Add(context.exchange.Bytes(context), directory->ResidentBytes(), private_scratch));
+    }
+    if (!proxy.valid) {
+      result.reason = proxy.reason;
+      return false;
+    }
+    if (joint) try {
+        placement = EngineTrial::ComposedSample(context, query[0], proxy.samples.at(0).sensor);
+        nearPlacement =
+            choice.geometric ? placement : EngineTrial::ComposedSample(context, query[1], proxy.samples.at(1).sensor);
+      } catch (const std::exception& e) {
+        failure.Set(2, 0, e.what());
+      }
+    if (!(ready = context.exchange.Vote(context, failure))) return false;
+  }
+  for (unsigned growth = 0; growth < 12 && trial_comm.Maximum(joint && !approved); ++growth) {
+    const auto work = concurrent ? trial_comm.Reduce(uint64_t(joint && !approved), CPassiveComm::Op::SUM) : uint64_t(1);
+    if (work > stats.work_limit - stats.global_work) {
+      stats.stop = EngineStop::WorkBudget;
+      result.reason = "Native3D joint repair exhausted the global work budget.";
+      return false;
+    }
+    stats.global_work += work;
+    if (options.maximum_seconds &&
+        trial_comm.Maximum(std::chrono::duration<double>(Clock::now() - started).count() >= options.maximum_seconds)) {
+      stats.stop = EngineStop::TimeBudget;
+      result.reason = "Native3D joint repair exhausted the elapsed budget.";
+      return false;
+    }
+    bool candidate = false;
+    Face obstruction{};
+    Feature refit_obstruction, preferred_obstruction;
+    const bool retained_frame = trial_comm.Maximum(joint && wallSplit);
+    const unsigned retained_frames = retained_frame ? 2 : 0;
+    const unsigned frames = (trial_comm.Maximum(joint && !choice.geometric) ? 2 : 1) + retained_frames;
+    for (unsigned frame = 0; frame < frames; ++frame) {
+      const bool participating = joint && !approved;
+      candidate = false;
+      {
+        Timer timer(stats.reconstruction_seconds, options.timings, SU2NativeTiming3D::Operation::Candidate);
+        CpuTimer cpu(stats.reconstruction_cpu_seconds, options.timings);
+        if (participating) try {
+            ++stats.repair_proposals;
+            const bool wall = std::any_of(old.surface.begin(), old.surface.end(), [&](const auto& f) {
+              return options.wall_heights.count(geometry.Get(f.facet).marker);
+            });
+            stats.wall_reconstruction_trials += wall;
+            if (retained_frame && frame < retained_frames && wallSplit) {
+              ++stats.wall_topology_trials;
+              if (frame == 0)
+                candidate = trial_checks.GuardedGeometry(
+                    boundary_replacement_ready, observe_transaction,
+                    wall_counters.TimeFrame("RefitWallSplit",
+                                            [&] {
+                                              return RefitWallSplit(old, choice.edge, point,
+                                                                    maximum_node + 2 + node_offset,
+                                                                    maximum_cell + 1 + offset, options.wall_heights,
+                                                                    geometry, fresh, refit_obstruction, result.reason);
+                                            }),
+                    "RefitWallSplit");
+              else
+                candidate = trial_checks.GuardedGeometry(
+                    boundary_replacement_ready, observe_transaction,
+                    wall_counters.TimeFrame("ReconstructWallSplit",
+                                            [&] {
+                                              return ReconstructWallSplit(
+                                                  old, choice.edge, point, maximum_node + 2 + node_offset,
+                                                  maximum_cell + 1 + offset, options.wall_heights, geometry, fresh,
+                                                  obstruction, result.reason, nullptr, options.surface_tolerance);
+                                            }),
+                    "ReconstructWallSplit");
+            } else if (!retained_frame || frame >= retained_frames) {
+              candidate = trial_checks.GuardedGeometry(
+                  boundary_replacement_ready, observe_transaction,
+                  wall_counters.TimeFrame("ReconstructSplitPatch",
+                                          [&] {
+                                            return ReconstructSplitPatch(
+                                                old, choice.edge, point, {maximum_node + 2 + node_offset, {}},
+                                                frame > retained_frames ? nearPlacement : placement,
+                                                maximum_cell + 1 + offset, geometry, fresh, obstruction, result.reason,
+                                                nullptr, options.wall_heights);
+                                          }),
+                  "ReconstructSplitPatch");
+            }
+          } catch (const std::exception& e) {
+            failure.Set(2, 0, e.what());
+          }
+        ready = context.exchange.Vote(context, failure);
+      }
+      if (!ready) return false;
+      const bool compound_refit = retained_frame && frame == 0;
+      // SplitInsertion uses strict lexicographic descent of the changed-edge length frontier,
+      // including refitted wall splits; it is not an unconditional size-progress exemption.
+      const bool split_refit =
+          compound_refit && !choice.geometric && GetRefineAcceptance() == RefineAcceptance::SplitInsertion;
+      auto validate_joint = [&](bool available,
+                                wall_diagnostics::PatchSource source = wall_diagnostics::PatchSource::Unreported) {
+        return split_refit
+                   ? trial_checks.ValidatePrivate(boundary_replacement_ready, observe_transaction, before, available,
+                                                  MetricChange::Refine, false, false,
+                                                  available ? trial_checks.ReservedRelocations() : 0, source)
+                   : trial_checks.ValidatePrivate(boundary_replacement_ready, observe_transaction, before, available,
+                                                  compound_refit     ? MetricChange::Refine
+                                                  : choice.geometric ? MetricChange::GeometryRefine
+                                                                     : MetricChange::Refine,
+                                                  false, compound_refit && !choice.geometric, 0, source);
+      };
+      const auto source = retained_frame && frame < retained_frames
+                              ? (frame == 0 ? wall_diagnostics::PatchSource::RefitWallSplit
+                                            : wall_diagnostics::PatchSource::ReconstructWallSplit)
+                              : wall_diagnostics::PatchSource::ReconstructSplitPatch;
+      bool passed = validate_joint(candidate, source);
+      if (!ready) return false;
+      const bool missing_closure = participating && retained_frame && frame < retained_frames && wallSplit &&
+                                   !candidate && (compound_refit ? refit_obstruction.count > 0 : obstruction != Face{});
+      bool close_first = trial_comm.Maximum(missing_closure);
+      if (missing_closure) preferred_obstruction = compound_refit ? refit_obstruction : Feature{obstruction, 3};
+      const bool repair = phase == Phase::Improvement && !close_first && participating && candidate && !passed &&
+                          certified.failure == MetricFailure::Shape && fresh.cells.size() <= MaximumReplacementCells &&
+                          !options.wall_heights.empty() && stats.global_work < stats.work_limit;
+      if (trial_comm.Maximum(repair)) {
+        const auto repair_limit = std::min<uint64_t>(
+            256, (stats.work_limit - stats.global_work) / trial_comm.Reduce(uint64_t(repair), CPassiveComm::Op::SUM));
+        Patch repair_seed;
+        if (repair) repair_seed = fresh;
+        uint64_t repair_used = 0;
+        bool retry = repair;
+        for (unsigned strategy = 0; strategy < 2 && trial_comm.Maximum(retry); ++strategy) {
+          const bool active = retry;
+          if (strategy && active) fresh = repair_seed;
+          // Movement needs the whole admitted domain, not donors for the previous proposal's queries.
+          DonorPatch donors;
+          {
+            Timer timer(stats.donor_seconds, options.timings, SU2NativeTiming3D::Operation::Import);
+            ++stats.donor_batches;
+            donors = trial_comm.ImportCells(
+                active ? old.cells : std::vector<Cell>{}, options.memory_ceiling,
+                transfer_memory::Add(context.exchange.Bytes(context), directory->ResidentBytes(), private_scratch));
+          }
+          CLocalFailure local;
+          ConnectivityRepairReport report;
+          bool repaired = false, missing_metric_star = false;
+          if (!donors.valid && !DonorCap(donors.reason)) local.Set(1, 0, donors.reason);
+          if (!(ready = context.exchange.Vote(context, local))) return false;
+          if (active && donors.valid) try {
+              const auto components = AssociatedExtensions(donors.cells, geometry);
+              observe_transaction("support_donors", donors.valid, &donors);
+              FrozenField target(std::move(donors.cells), composition, options.timings, components,
+                                 options.edge_breakpoints, field_identity, true, MaximumDonors, true);
+              FieldAccounting accounting{stats, target};
+              Patch proposal;
+              std::string rejected;
+              {
+                Timer timer(stats.reconstruction_seconds, options.timings, SU2NativeTiming3D::Operation::Candidate);
+                CpuTimer cpu(stats.reconstruction_cpu_seconds, options.timings);
+                // Probe the whole actual-field interface before exhausting repair on a fixed support point.
+                RepairMetricConnectivity(fresh, target, geometry, options.wall_heights, maximum_cell + 1 + offset,
+                                         proposal, report, rejected, 0);
+                missing_metric_star = report.blocked_interior_vertex != UINT64_MAX;
+                if (missing_metric_star && !preferred_obstruction.count)
+                  preferred_obstruction = {{{report.blocked_interior_vertex, 0, 0}}, 1};
+                if (!missing_metric_star)
+                  repaired =
+                      RepairMetricConnectivity(fresh, target, geometry, options.wall_heights, maximum_cell + 1 + offset,
+                                               proposal, report, rejected, repair_limit - repair_used, strategy == 0);
+              }
+              stats.wall_joint_trials += report.trials;
+              stats.wall_joint_moves += report.moves;
+              stats.wall_joint_removals += report.removals;
+              stats.wall_joint_flips += report.flips;
+              stats.wall_joint_vertex_moves += report.vertex_moves;
+              stats.wall_joint_coordinated += report.coordinated;
+              stats.wall_joint_solve_rejected += report.solve_rejected;
+              stats.wall_joint_move_geometry_rejected += report.move_geometry_rejected;
+              stats.wall_joint_move_height_rejected += report.move_height_rejected;
+              stats.wall_joint_move_loss_rejected += report.move_loss_rejected;
+              stats.metric_linearizations += report.linearizations;
+              stats.metric_probes += report.metric_probes;
+              stats.metric_linear_iterations += report.linear_iterations;
+              stats.metric_solve_trials += report.solve_trials;
+              if (repaired) {
+                std::map<Id, Point> previous;
+                std::set<Id> used;
+                for (const auto& c : old.cells)
+                  for (auto n : c.v) previous.emplace(n.id, n.p);
+                for (const auto& c : proposal.cells)
+                  for (auto n : c.v) used.insert(n.id);
+                std::map<Id, Id> renamed;
+                size_t cursor = 0;
+                const Id first_node = maximum_node + 1 + node_offset;
+                for (const auto& c : proposal.cells)
+                  for (auto n : c.v) {
+                    const auto found = previous.find(n.id);
+                    if (found == previous.end() || renamed.count(n.id)) continue;
+                    const auto p = found->second;
+                    if (p.x == n.p.x && p.y == n.p.y && p.z == n.p.z) continue;
+                    while (cursor < construction_nodes && used.count(first_node + cursor)) ++cursor;
+                    if (cursor == construction_nodes)
+                      throw std::invalid_argument("Native3D joint movement exceeds reserved node identities.");
+                    renamed.emplace(n.id, first_node + cursor);
+                    used.insert(first_node + cursor++);
+                  }
+                // Fresh identities invalidate selection reuse and preserve transfer's unchanged-node contract.
+                for (auto& c : proposal.cells)
+                  for (auto& n : c.v)
+                    if (renamed.count(n.id)) n.id = renamed.at(n.id);
+                for (auto& f : proposal.surface)
+                  for (auto& id : f.v)
+                    if (renamed.count(id)) id = renamed.at(id);
+                fresh = std::move(proposal);
+                repaired = trial_checks.GuardedGeometry(boundary_replacement_ready, observe_transaction, true);
+              }
+            } catch (const std::exception& e) {
+              local.Set(2, 0, e.what());
+            }
+          repair_used += report.trials;
+          stats.global_work += trial_comm.Reduce(uint64_t(report.trials), CPassiveComm::Op::SUM);
+          if (!(ready = context.exchange.Vote(context, local))) return false;
+          close_first = close_first || trial_comm.Maximum(missing_metric_star);
+          if (trial_comm.Maximum(repaired)) {
+            const bool accepted = validate_joint(repaired);
+            if (active) passed = accepted;
+            stats.wall_joint_accepted += repaired && accepted;
+            if (!ready) return false;
+          }
+          if (active && !passed && report.blocked_interior_vertex != UINT64_MAX && !preferred_obstruction.count)
+            preferred_obstruction = {{{report.blocked_interior_vertex, 0, 0}}, 1};
+          // Shape-only retirement may lose required size resolution; backtrack within the same trial allocation.
+          retry = active && strategy == 0 && repaired && !passed && report.complete_shape && report.removals &&
+                  certified.failure == MetricFailure::Progress && repair_used < repair_limit;
+        }
+      }
+      if (participating && !passed) try {
+          if (candidate && certified.failure == MetricFailure::Shape) {
+            const auto boundary = Incidence(old.cells).Boundary();
+            std::set<Face> artificial;
+            std::set<Id> fixed, physical;
+            for (const auto& f : old.surface) physical.insert(f.v.begin(), f.v.end());
+            for (auto f : boundary)
+              if (std::none_of(old.surface.begin(), old.surface.end(),
+                               [&](const auto& p) { return Key(p.v) == Key(f); })) {
+                artificial.insert(Key(f));
+                fixed.insert(f.begin(), f.end());
+              }
+            for (const auto& c : fresh.cells)
+              if (c.id == certified.weakest_cell || c.id == certified.sliver_cell) {
+                const auto faces = Faces(c);
+                const auto found =
+                    std::find_if(faces.begin(), faces.end(), [&](Face f) { return artificial.count(Key(f)); });
+                if (found != faces.end()) {
+                  obstruction = Key(*found);
+                  if (!preferred_obstruction.count) preferred_obstruction = {obstruction, 3};
+                  break;
+                }
+                for (auto n : c.v)
+                  if (fixed.count(n.id) && !physical.count(n.id) && !preferred_obstruction.count)
+                    preferred_obstruction = {{{n.id, 0, 0}}, 1};
+              }
+          }
+          // Preserve the first mechanism's actual blockage; a later fallback must not overwrite its dependency.
+          if (!preferred_obstruction.count && obstruction != Face{}) preferred_obstruction = {obstruction, 3};
+        } catch (const std::exception& e) {
+          failure.Set(2, 0, e.what());
+        }
+      if (!(ready = context.exchange.Vote(context, failure))) return false;
+      if (participating) {
+        stats.wall_topology_accepted += passed && retained_frame && frame < retained_frames && wallSplit;
+        approved = passed;
+        if (passed && std::any_of(old.surface.begin(), old.surface.end(), [&](const auto& f) {
+              return options.wall_heights.count(geometry.Get(f.facet).marker);
+            }))
+          ++stats.wall_reconstruction_accepted;
+      }
+      if (!ready) return false;
+      // Resolve a required retained-row interface before spending trials on incomplete fallback fans.
+      if (close_first || !trial_comm.Maximum(joint && !approved)) break;
+    }
+    if (joint && approved) {
+      cavity_inserted = true;
+      joint = false;
+    } else if (joint && candidate && certified.failure == MetricFailure::Measurement)
+      joint = false;
+    if (!trial_comm.Maximum(joint && !approved)) break;
+    if (!preferred_obstruction.count && std::adjacent_find(obstruction.begin(), obstruction.end()) == obstruction.end())
+      preferred_obstruction = {obstruction, 3};
+    const bool grow = joint && preferred_obstruction.count;
+    const auto added_dependencies = directory->LookupBatch(
+        grow ? std::vector<Feature>{preferred_obstruction} : std::vector<Feature>{}, options.memory_ceiling,
+        transfer_memory::Add(context.exchange.Bytes(context), source.ResidentBytes(), private_scratch));
+    if (!added_dependencies.valid) {
+      result.reason = added_dependencies.reason;
+      return false;
+    }
+    Dependencies neighbor;
+    neighbor.valid = true;
+    if (grow) {
+      neighbor = added_dependencies.candidates.at(0);
+      if (!neighbor.valid) {
+        if (neighbor.reason == "Native 3D dependency star exceeds budget.")
+          joint = false;
+        else
+          failure.Set(1, 0, neighbor.reason);
+      }
+    } else
+      joint = false;
+    if (!(ready = context.exchange.Vote(context, failure))) return false;
+    if (!trial_comm.Maximum(joint)) break;
+    if (!joint) neighbor.cells.clear();
+    neighbor.valid = true;
+    const auto more = directory->Fetch(
+        neighbor, working, options.memory_ceiling,
+        transfer_memory::Add(context.exchange.Bytes(context), source.ResidentBytes(), private_scratch));
+    if (!more.valid) {
+      result.reason = more.reason;
+      return false;
+    }
+    if (joint) try {
+        auto joined = dependencies.cells;
+        auto payload = imported.cells;
+        for (const auto& dep : neighbor.cells) {
+          const auto found =
+              std::find_if(joined.begin(), joined.end(), [&](const auto& d) { return d.cell == dep.cell; });
+          if (found != joined.end()) {
+            if (found->version != dep.version || found->owner != dep.owner)
+              throw std::runtime_error("Native3D joint dependency changed ownership/version.");
+          } else
+            joined.push_back(dep);
+        }
+        if (joined.size() == dependencies.cells.size() || joined.size() > MaximumCavityCells) joint = false;
+        if (joint) {
+          for (const auto& row : more.cells)
+            if (std::none_of(payload.begin(), payload.end(), [&](const auto& c) { return c.cell.id == row.cell.id; }))
+              payload.push_back(row);
+          dependencies.cells.swap(joined);
+          imported.cells.swap(payload);
+          old = GeometryPatch(imported, &geometry);
+          reuse.clear();
+          for (const auto& c : old.cells) selection.Cached(c, reuse);
+        }
+      } catch (const std::exception& e) {
+        failure.Set(2, 0, e.what());
+      }
+    if (!(ready = context.exchange.Vote(context, failure))) return false;
+    if (!trial_comm.Maximum(joint)) break;
+    const bool reserved = reserve_dependencies(
+        imported, joint, result.reason, options.memory_ceiling,
+        transfer_memory::Add(context.exchange.Bytes(context), source.ResidentBytes(), private_scratch),
+        choice.reservation_priority);
+    CLocalFailure reservation_failure;
+    if (joint && !reserved) {
+      if (directory->PassDeferred()) {
+        ++stats.conflicts;
+        joint = false;
+        approved = false;
+      } else if (concurrent && result.reason == "Native 3D conflicting dependency reservation.")
+        ++stats.conflicts;
+      else
+        reservation_failure.Set(1, 0, "Native3D joint patch lost complete dependency reservation.");
+    }
+    if (!(ready = context.exchange.Vote(context, reservation_failure))) return false;
+    if (!trial_comm.Maximum(joint)) break;
+    try {
+      observe_transaction("growth_reserved", reserved);
+    } catch (const std::exception& e) {
+      failure.Set(2, 0, e.what());
+    }
+    if (capture && !context.exchange.Vote(context, failure)) return false;
+    const bool measured =
+        trial_checks.MeasurePrivate(observe_transaction, joint ? old.cells : empty, before, false, reuse, &old);
+    if (!ready) return false;
+    CLocalFailure old_invalid;
+    if (joint && !measured) old_invalid.Set(1, 0, result.reason);
+    if (!(ready = context.exchange.Vote(context, old_invalid))) return false;
+  }
+  return true;
+}
