+  bool TryStoredFieldRepair(bool move, Id vertex, PatchMetric& metric, const std::map<Edge, EdgeMeasure>& reuse);
+  void TryStoredFieldMove(const std::map<Id, Node>& nodes, Id vertex, Id first, PatchMetric& metric,
