+namespace {
+std::string CaptureOwnership(World& world, const Owned& input, const std::vector<DonorCell>& donors,
+                             const PlanarReference& geometry, bool closed) {
+  EngineOptions options;
+  options.phase_ownership = PhaseOwnership::Automatic;
+  options.maximum_work = 8192;
+  options.maximum_rounds = 1;
+  options.timings = true;
+  options.close_construction_collapse = closed;
+  std::ostringstream captured;
+  {
+    struct RestoreOutput {
+      std::streambuf* previous;
+      ~RestoreOutput() { std::cout.rdbuf(previous); }
+    } restore{std::cout.rdbuf(captured.rdbuf())};
+    AdaptMetric(world, input, donors, geometry, {}, options);
+  }
+  return captured.str();
+}
+
+using OwnershipFields = std::map<std::string, std::string>;
+
+OwnershipFields ConstructionOwnership(const std::string& log) {
+  std::vector<std::string> decisions;
+  std::istringstream lines(log);
+  for (std::string line; std::getline(lines, line);)
+    if (line.find("NATIVE3D_PHASE_OWNERSHIP ") == 0 && line.find(" quality=0 evaluate=1 ") != std::string::npos)
+      decisions.push_back(line);
+  INFO(log);
+  REQUIRE(decisions.size() == 1);
+  std::cout << decisions.front() << '\n';
+  OwnershipFields fields;
+  std::istringstream words(decisions.front());
+  for (std::string word; words >> word;) {
+    const auto equal = word.find('=');
+    if (equal != std::string::npos)
+      REQUIRE(fields.emplace(word.substr(0, equal), word.substr(equal + 1)).second);
+  }
+  REQUIRE(fields.at("attempts") == "0");
+  return fields;
+}
+
+bool RawOwnershipPays(const OwnershipFields& fields) {
+  const auto number = [&](const char* key) { return std::stod(fields.at(key)); };
+  return OwnershipExchangePays(number("predicted_imbalance"), number("demand_sum"), number("global_cells"),
+                               number("measured"), number("attempts"));
+}
+
+void CheckCellPolicy(const OwnershipFields& fields, uint64_t maximum, double ratio) {
+  REQUIRE(fields.at("policy") == "cells");
+  REQUIRE(std::stoull(fields.at("max_owned_cells")) == maximum);
+  REQUIRE(std::stod(fields.at("owned_ratio")) == ratio);
+}
+
+OwnershipFields LegacyOwnership(OwnershipFields fields) {
+  for (const auto* key : {"migrate", "policy", "max_owned_cells", "owned_ratio"}) fields.erase(key);
+  return fields;
+}
+
+Fixture OwnershipBoxes() {
+  Fixture result = Box();
+  auto other = Box();
+  const auto shift = [](Node& node) {
+    node.id += 8;
+    node.p.x += 3;
+  };
+  for (auto& cell : other.patch.cells) {
+    cell.id += 6;
+    for (auto& node : cell.v) shift(node);
+  }
+  for (auto& face : other.patch.surface) {
+    face.facet += 12;
+    for (auto& id : face.v) id += 8;
+  }
+  for (auto& facet : other.facets) {
+    facet.id += 12;
+    facet.marker += 12;
+    for (auto& node : facet.v) shift(node);
+  }
+  result.patch.cells.insert(result.patch.cells.end(), other.patch.cells.begin(), other.patch.cells.end());
+  result.patch.surface.insert(result.patch.surface.end(), other.patch.surface.begin(), other.patch.surface.end());
+  result.facets.insert(result.facets.end(), other.facets.begin(), other.facets.end());
+  return result;
+}
