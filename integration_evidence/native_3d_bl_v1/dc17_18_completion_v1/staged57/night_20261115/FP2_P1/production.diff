+witness::Result CloseWitness(const std::vector<UnionTriangle>& input, double resolution, AtlasBudget& budget) {
+  using transfer_memory::Add;
+  using transfer_memory::Mul;
+  WitnessTopology topology;
+  std::vector<WitnessChord> working;
+  witness::Result result;
+  const size_t vertices = Mul(input.size(), 3);
+  using Vertices = decltype(topology.vertices);
+  using Owners = decltype(topology.owners);
+  const size_t vertex_bytes = Mul(vertices, sizeof(Vertices::value_type) + 4 * sizeof(void*) + sizeof(Point));
+  // Each chord contributes at most six directed incidences, including the edge and owner nodes.
+  const size_t incidence_bytes = 6 * (sizeof(Owners::value_type) + sizeof(size_t) + 8 * sizeof(void*));
+  const size_t fixed = sizeof(topology) + sizeof(working) + sizeof(result) + sizeof(WitnessChain) +
+                       8 * (sizeof(WitnessChord) + sizeof(Box));
+  auto admit = [&](size_t work_capacity, size_t chords, size_t additional) {
+    AtlasOps::Storage(budget, Add(fixed, vertex_bytes, Mul(work_capacity, sizeof(WitnessChord)),
+                                 Mul(chords, incidence_bytes), additional), "QuerySurfaceUnionAtResolution");
+  };
+  admit(input.size(), input.size(), 0);
+  topology.points.reserve(vertices);
+  working.reserve(input.size());
+  for (size_t i = 0; i < input.size(); ++i) {
+    AtlasOps::Work(budget, 1);
+    working.push_back({input[i], topology.Vertices(input[i]), {}, i});
+    topology.Update(working.back().ids, i, true);
+  }
+  const double limit = WitnessLimit(resolution);
+  auto& counters = result.counters;
+  for (size_t index = 0; index < working.size(); ++index) {
+    for (unsigned k = 0; k < 3;) {
+      AtlasOps::Work(budget, 1);
+      const auto chain = FindWitnessChain(topology, working[index], index, k, limit,
+                                          [&] { AtlasOps::Work(budget, 1); });
+      if (chain.status == WitnessChain::DeadEnd) ++counters.reject_dead_end;
+      if (chain.status == WitnessChain::Long) ++counters.reject_long;
+      std::array<WitnessChord, 8> fan;
+      if (chain.status != WitnessChain::Complete ||
+          !WitnessFan(topology, working[index], k, chain, input[working[index].origin].error, budget, fan, counters)) {
+        ++k;
+        continue;
+      }
+      const size_t total = Add(working.size(), chain.length - 1);
+      const size_t capacity = working.capacity();
+      if (total > capacity) {
+        const size_t next_capacity = std::max(total, Add(capacity, capacity / 2));
+        admit(next_capacity, total, Mul(capacity, sizeof(WitnessChord)));
+        working.reserve(next_capacity);
+      } else {
+        admit(capacity, total, 0);
+      }
+      topology.Update(working[index].ids, index, false);
+      working[index] = fan[0];
+      topology.Update(fan[0].ids, index, true);
+      for (unsigned i = 1; i < chain.length; ++i) {
+        topology.Update(fan[i].ids, working.size(), true);
+        working.push_back(fan[i]);
+      }
+      ++counters.splits;
+      counters.children += chain.length;
+      if (chain.length == 2) ++counters.chain2;
+      else if (chain.length == 3) ++counters.chain3;
+      else if (chain.length == 4) ++counters.chain4;
+      else ++counters.chain5_8;
+      k = 0;
+    }
+  }
+  admit(working.capacity(), working.size(), Mul(working.size(), sizeof(UnionTriangle) + sizeof(size_t)));
+  result.chords.reserve(working.size());
+  result.origin.reserve(working.size());
+  for (const auto& chord : working) {
+    result.chords.push_back(chord.chord);
+    result.origin.push_back(chord.origin);
+  }
+  return result;
+}
+
+size_t LeftClosable(const std::vector<UnionTriangle>& input, const std::vector<UnionTriangle>& closed, double resolution) {
+  WitnessTopology topology;
+  for (const auto& chord : input) topology.Vertices(chord);
+  std::vector<WitnessChord> working;
+  working.reserve(closed.size());
+  for (const auto& chord : closed) {
+    working.push_back({chord, topology.Vertices(chord), {}, 0});
+    topology.Update(working.back().ids, working.size() - 1, true);
+  }
+  const double limit = WitnessLimit(resolution);
+  size_t closable = 0;
+  for (size_t i = 0; i < working.size(); ++i) {
+    const auto& chord = working[i];
+    for (unsigned k = 0; k < 3; ++k) {
+      closable += FindWitnessChain(topology, chord, i, k, limit, [] {}).status == WitnessChain::Complete;
+    }
+  }
+  return closable;
+}
+
+void TraceClosedWitness(const std::vector<UnionTriangle>& input, const witness::Result& result, double resolution) {
+  std::string left = "-1";
+  try {
+    left = std::to_string(LeftClosable(input, result.chords, resolution));
+  } catch (...) {
+  }
+  std::string origins;
+  for (const auto i : result.origin) {
+    origins += std::to_string(i);
+    origins += ',';
+  }
+  const auto& c = result.counters;
+  std::fprintf(stderr, "NATIVE_SURFACE_WITNESS_CLOSED chords_in=%zu chords_out=%zu splits=%zu children=%zu"
+      " chain2=%zu chain3=%zu chain4=%zu chain5_8=%zu reject_dead_end=%zu reject_long=%zu reject_fan_key=%zu"
+      " reject_not_finite=%zu reject_orientation=%zu reject_projection=%zu left_closable=%s origin=%s\n",
+      input.size(), result.chords.size(), c.splits, c.children, c.chain2, c.chain3, c.chain4, c.chain5_8,
+      c.reject_dead_end, c.reject_long, c.reject_fan_key, c.reject_not_finite, c.reject_orientation,
+      c.reject_projection, left.c_str(), origins.c_str());
+}
