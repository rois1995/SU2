+using WitnessEdge = std::pair<Id, Id>;
+
+struct WitnessTopology {
+  std::map<Vec, Id> vertices;
+  std::vector<Point> points;
+  std::map<WitnessEdge, std::set<size_t>> owners;
+
+  std::array<Id, 3> Vertices(const UnionTriangle& chord) {
+    std::array<Id, 3> ids;
+    for (unsigned k = 0; k < 3; ++k) {
+      const auto inserted = vertices.emplace(Values(chord.points[k]), points.size());
+      if (inserted.second) points.push_back(chord.points[k]);
+      ids[k] = inserted.first->second;
+    }
+    return ids;
+  }
+
+  void Update(const std::array<Id, 3>& ids, size_t chord, bool insert) {
+    for (unsigned k = 0; k < 3; ++k) {
+      const Id a = ids[k], b = ids[(k + 1) % 3];
+      UpdateEdge({a, b}, chord, insert);
+      if (a != b) UpdateEdge({b, a}, chord, insert);
+    }
+  }
+
+ private:
+  void UpdateEdge(WitnessEdge key, size_t chord, bool insert) {
+    if (insert) {
+      owners[key].insert(chord);
+    } else {
+      const auto edge = owners.find(key);
+      if (edge == owners.end()) return;  // A degenerate chord can repeat a key.
+      edge->second.erase(chord);
+      if (edge->second.empty()) owners.erase(edge);
+    }
+  }
+};
+
+struct WitnessChord {
+  UnionTriangle chord;
+  std::array<Id, 3> ids;
+  Vec offsets{};
+  size_t origin;
+};
+
+struct WitnessChain {
+  std::array<Id, 9> ids{};
+  std::array<double, 9> delta{};
+  unsigned length = 0;
+  enum Status { Skip, Complete, DeadEnd, Long } status = Skip;
+};
+
+std::pair<unsigned, int> WitnessProjection(const Box& normal) {
+  unsigned axis = 0;
+  for (unsigned d = 1; d < 3; ++d) {
+    if (std::abs(normal[d].lo + normal[d].hi) > std::abs(normal[axis].lo + normal[axis].hi)) axis = d;
+  }
+  return {axis, normal[axis].lo > 0 ? 1 : normal[axis].hi < 0 ? -1 : 0};
+}
+
+Box WitnessNormal(const UnionTriangle& chord) {
+  const auto base = Exact(chord.points[0]);
+  return CrossBox(Difference(Exact(chord.points[1]), base), Difference(Exact(chord.points[2]), base));
+}
+
+bool FiniteWitnessBox(const Box& box) {
+  for (const auto& r : box) {
+    if (!std::isfinite(r.lo) || !std::isfinite(r.hi)) return false;
+  }
+  return true;
+}
+
+double WitnessDot(const Vec& a, const Vec& b) {
+  // The affine translation unit disables FP contraction.
+  const double x = a[0] * b[0], y = a[1] * b[1], z = a[2] * b[2];
+  const double sum = x + y, value = sum + z;
+  if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z) ||
+      !std::isfinite(sum) || !std::isfinite(value)) return NAN;
+  return value;
+}
+
+Vec WitnessDifference(Point a, Point b) { return {a.x - b.x, a.y - b.y, a.z - b.z}; }
+
+double WitnessLimit(double resolution) {
+  const long double exact = std::ldexp(static_cast<long double>(resolution), -3);
+  const double nearest = static_cast<double>(exact);
+  return nearest > exact ? std::nextafter(nearest, -INFINITY) : nearest;
+}
+
+template <class Work>
+WitnessChain FindWitnessChain(const WitnessTopology& topology, const WitnessChord& parent, size_t index,
+                              unsigned k, double limit, Work work) {
+  WitnessChain chain;
+  const unsigned j = (k + 1) % 3, l = (k + 2) % 3;
+  const Id a = parent.ids[k], b = parent.ids[j], c = parent.ids[l];
+  const auto edge = topology.owners.find({a, b});
+  if (edge == topology.owners.end() || edge->second.size() != 1 || !WitnessProjection(WitnessNormal(parent.chord)).second)
+    return chain;
+
+  const auto base = parent.chord.points[k], end = parent.chord.points[j];
+  const auto u = WitnessDifference(end, base);
+  const double q = WitnessDot(u, u);
+  if (!(q > 0)) return chain;
+  const auto exact_base = Exact(base);
+  const auto exact_u = Difference(Exact(end), exact_base);
+  double current_t = 0;
+  chain.ids[0] = a;
+  while (chain.length < 8) {
+    work();
+    const Id current = chain.ids[chain.length];
+    auto adjacency = topology.owners.lower_bound({current, 0});
+    bool found = false;
+    Id best = 0;
+    double best_t = 1, best_delta = 0;
+    for (; adjacency != topology.owners.end() && adjacency->first.first == current; ++adjacency) {
+      const auto id = adjacency->first.second;
+      if (adjacency->second.size() != 1 || *adjacency->second.begin() == index || id == a || id == c) continue;
+      work();
+      double t = 1, delta = 0;
+      if (id != b) {
+        const auto point = topology.points[id];
+        t = WitnessDot(WitnessDifference(point, base), u) / q;
+        if (!(current_t < t && t < 1)) continue;
+        Box foot;
+        for (unsigned d = 0; d < 3; ++d) foot[d] = Add(exact_base[d], Multiply(exact_u[d], t));
+        if (!FiniteWitnessBox(foot)) continue;
+        const auto displacement = Difference(Exact(point), foot);
+        if (!FiniteWitnessBox(displacement)) continue;
+        delta = NormBound(displacement);
+        if (!std::isfinite(delta) || !(delta <= limit)) continue;
+      }
+      if (!found || std::make_pair(t, id) < std::make_pair(best_t, best)) {
+        found = true;
+        best = id;
+        best_t = t;
+        best_delta = delta;
+      }
+    }
+    if (!found) {
+      if (chain.length) chain.status = WitnessChain::DeadEnd;
+      return chain;
+    }
+    chain.ids[++chain.length] = best;
+    chain.delta[chain.length] = best_delta;
+    if (best == b) {
+      chain.status = WitnessChain::Complete;
+      return chain;
+    }
+    current_t = best_t;
+  }
+  chain.status = WitnessChain::Long;
+  return chain;
+}
+
+double WitnessAddUp(double a, double b) {
+  const auto hi = Add({a, a}, {b, b}).hi;
+  const double nearest = static_cast<double>(hi);
+  return nearest < hi ? std::nextafter(nearest, INFINITY) : nearest;
+}
+
+bool WitnessFan(const WitnessTopology& topology, const WitnessChord& parent, unsigned k, const WitnessChain& chain,
+                double original_error, AtlasBudget& budget, std::array<WitnessChord, 8>& fan, witness::Counters& counters) {
+  const unsigned j = (k + 1) % 3, l = (k + 2) % 3;
+  const Id c = parent.ids[l];
+  for (unsigned i = 1; i < chain.length; ++i) {
+    if (topology.owners.count({chain.ids[i], c})) {
+      ++counters.reject_fan_key;
+      return false;
+    }
+  }
+  const double edge_offset = std::max(parent.offsets[k], parent.offsets[j]);
+  double first_offset = parent.offsets[k];
+  Point first_point = parent.chord.points[k];
+  for (unsigned i = 0; i < chain.length; ++i) {
+    AtlasOps::Work(budget, 1);
+    const bool last = i + 1 == chain.length;
+    const double next_offset = last ? parent.offsets[j] : WitnessAddUp(chain.delta[i + 1], edge_offset);
+    const Point next_point = last ? parent.chord.points[j] : topology.points[chain.ids[i + 1]];
+    const double error = WitnessAddUp(original_error, std::max({first_offset, next_offset, parent.offsets[l]}));
+    if (!std::isfinite(first_offset) || !std::isfinite(next_offset) || !std::isfinite(parent.offsets[l]) ||
+        !std::isfinite(error)) {
+      ++counters.reject_not_finite;
+      return false;
+    }
+    fan[i] = {{{first_point, next_point, parent.chord.points[l]}, error},
+              {chain.ids[i], chain.ids[i + 1], c}, {first_offset, next_offset, parent.offsets[l]}, parent.origin};
+    first_point = next_point;
+    first_offset = next_offset;
+  }
+  const auto parent_normal = WitnessNormal(parent.chord);
+  const auto projection = WitnessProjection(parent_normal);
+  std::array<Box, 8> normals;
+  for (unsigned i = 0; i < chain.length; ++i) {
+    normals[i] = WitnessNormal(fan[i].chord);
+    if (!(DotBox(normals[i], parent_normal).lo > 0)) {
+      ++counters.reject_orientation;
+      return false;
+    }
+  }
+  for (unsigned i = 0; i < chain.length; ++i) {
+    if (WitnessProjection(normals[i]) != projection) {
+      ++counters.reject_projection;
+      return false;
+    }
+  }
+  return true;
+}
