+TEST_CASE("Native point preparation retains certified support and recovers after dense footprints", "[NativePreparationReuse3D]") {
+  World world;std::vector<DonorCell> original;Owned working;std::string reason;
+  Id cellId=0,nodeId=0;
+  auto add=[&](std::array<Node,4> nodes,bool selected) {
+    DonorCell row;row.cell={cellId++,nodes};row.sensor.fill({1,0,0,1,0,1});
+    if(Orientation(nodes[0].p,nodes[1].p,nodes[2].p,nodes[3].p)<0)std::swap(row.cell.v[0],row.cell.v[1]);
+    if(row.cell.id%world.size==unsigned(world.rank))original.push_back(row);
+    if(!world.rank && selected){OwnedCell owned;owned.cell=row.cell;working.emplace(owned.cell.id,owned);}
+  };
+  // Each selected apex touches200 original tetrahedra; two such footprints exceed the256-donor cap.
+  for(unsigned cluster=0;cluster<4;++cluster) {
+    Node apex{nodeId++,{10.*cluster,0,0}};std::array<std::array<Node,11>,11> grid;
+    for(unsigned j=0;j<=10;++j)for(unsigned i=0;i<=10;++i)grid[j][i]={nodeId++,{10.*cluster+double(i)/10,double(j)/10,1}};
+    for(unsigned j=0;j<10;++j)for(unsigned i=0;i<10;++i) {
+      add({apex,grid[j][i],grid[j][i+1],grid[j+1][i]},j==0);
+      add({apex,grid[j+1][i+1],grid[j+1][i],grid[j][i+1]},false);
+    }
+  }
+  for(unsigned i=0;i<100;++i) {
+    const double x=100+2*i;std::array<Node,4> nodes{{{nodeId++,{x,0,0}},{nodeId++,{x+1,0,0}},
+        {nodeId++,{x,1,0}},{nodeId++,{x,0,1}}}};add(nodes,true);
+  }
+  DonorImport source(world,true);REQUIRE(source.Build(original,reason));
+  auto combined=[](Point p,Tensor m){m.zz+=.125*p.z+.03125*p.x;return m;};
+  uint64_t calls=0;MetricComposition composition=[&](Point p,Tensor m){++calls;return combined(p,m);};
+  std::vector<uint32_t> result;BridgeStats stats;
+  REQUIRE(WorkingWeights(world,working,source,result,reason,stats,composition));
+  REQUIRE(result.size()==working.size());CHECK(stats.compositions==calls);CHECK(calls==5*working.size());
+  CHECK(stats.requests==stats.hits+stats.misses+stats.invalid_queries);CHECK(stats.failures==0);
+  CHECK(world.sum(stats.batch_retries)>0);CHECK(world.sum(stats.support_resets)>0);
+  CHECK(world.sum(stats.batch_recoveries)>0);CHECK(stats.field_builds<=working.size());
+  CHECK(world.sum(stats.field_reuses)>0);CHECK(world.sum(stats.support_hits)>0);
+  size_t at=0;for(const auto& row:working) {
+    DonorCell donor;donor.cell=row.second.cell;donor.sensor.fill({1,0,0,1,0,1});
+    FrozenField direct({donor},combined);CHECK(result[at++]==WorkWeights({donor.cell},direct).front());
+  }
+  uint64_t attempted=0;MetricComposition failing=[&](Point p,Tensor m) {
+    if(++attempted==71)throw std::runtime_error("Injected retained preparation query failure.");return combined(p,m);
+  };
+  std::vector<uint32_t> preserved{123};BridgeStats failed;
+  CHECK_FALSE(WorkingWeights(world,working,source,preserved,reason,failed,failing));
+  CHECK(preserved==std::vector<uint32_t>{123});CHECK(failed.compositions==attempted);
+  CHECK(failed.requests==attempted);CHECK(failed.requests==failed.hits+failed.misses+failed.invalid_queries);
+  CHECK(world.sum(failed.failures)==1);
+}
