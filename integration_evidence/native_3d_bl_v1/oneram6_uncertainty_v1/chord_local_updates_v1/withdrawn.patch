+TEST_CASE("Finite-feature chord updates retain untouched intervals and reject losing supports", "[NativeChordEnvelope]") {
+  using E=SU2Native3D::ChordEnvelope;using P=std::array<double,3>;
+  for(unsigned order=0;order<3;++order) {
+    E envelope({-1,.1,0},{22,.1,0});
+    for(unsigned step=0;step<21;++step) {
+      const unsigned k=order==0?step:order==1?20-step:(8*step)%21;
+      const double z=.02*(k%3);const P a{double(k),0,z},b{k+.8,0,z};
+      envelope.Vertex(a);envelope.Segment(a,b);envelope.Vertex(b);
+      envelope.Segment({double(k),0,50},{k+.8,0,50});
+    }
+    for(unsigned k=0;k<=2048;++k) {
+      const double t=k/2048.,x=-1+23*t;double reference=INFINITY;
+      for(unsigned j=0;j<21;++j) {
+        const double dx=x-std::max(double(j),std::min(j+.8,x)),z=.02*(j%3);
+        reference=std::min(reference,std::hypot(dx,.1,z));
+      }
+      CHECK(double(envelope.Distance(t))==Approx(reference).epsilon(1e-13));
+    }
+    const auto cuts=envelope.Cuts({.12,.2});
+    for(double t:cuts)CHECK(std::isfinite(envelope.Distance(t)));
+    CHECK(envelope.Pieces()>21);CHECK(envelope.Features()>63);
+  }
+}
