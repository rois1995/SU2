+Node NormalWallPoint(const Face& face,const std::map<Id,Node>& nodes,double height,Id id) {
+  const auto a=nodes.at(face[0]).p,b=nodes.at(face[1]).p,c=nodes.at(face[2]).p;
+  auto normal=Cross(Delta(b,a),Delta(c,a));const auto length=Norm(normal);
+  if(!(length>0))throw std::invalid_argument("Native3D first-layer face is degenerate.");
+  for(auto& value:normal)value/=length;
+  Point center{double(((long double)a.x+b.x+c.x)/3),double(((long double)a.y+b.y+c.y)/3),
+               double(((long double)a.z+b.z+c.z)/3)};
+  // Physical skin is outward; the new apex uses the inward normal.
+  return {id,{double((long double)center.x-height*normal[0]),double((long double)center.y-height*normal[1]),
+              double((long double)center.z-height*normal[2])}};
