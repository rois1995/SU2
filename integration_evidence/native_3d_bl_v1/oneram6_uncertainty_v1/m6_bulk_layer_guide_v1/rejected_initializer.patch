+      if(wall)throw std::invalid_argument("Native3D direct wall cap requires exactly one requested wall face.");
+      wall=&entry.second;height=h->second;
+    }
+    if(!wall || !(height>0) || !std::isfinite(height) || nodes.count(apex))
+      throw std::invalid_argument("Native3D direct wall cap lacks a valid height or newly reserved apex.");
+    Patch proposal;
+    if(!Cone(old.cells,NormalWallPoint(wall->v,nodes,height,apex),first_cell,proposal.cells,reason,stats))
+      throw std::invalid_argument(reason);
+    Finish(old,proposal,skin,physical,reference,stats);
+    FirstHeightReport report;
+    if(!CheckFirstHeight(proposal,heights,reference,report,reason,stats))throw std::invalid_argument(reason);
+    fresh=std::move(proposal);reason.clear();return true;
+  }catch(const std::exception& error){reason=error.what();return false;}
+}
