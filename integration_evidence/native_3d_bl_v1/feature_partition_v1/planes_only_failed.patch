+    if(piece.n==4) {
+      // A tetrahedral piece already has the positive degree-two rule; avoid four redundant fans.
+      BLTetrahedron t;
+      for(unsigned k=0;k<4;++k)for(unsigned j=0;j<3;++j)t[k][j]=piece.x[k][j];
