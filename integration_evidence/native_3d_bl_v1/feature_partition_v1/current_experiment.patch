+void VisitBLTetrahedra(const convex_clip::Polyhedron& piece,Append append) {
+  if(!piece.n) return;
+    if(piece.n==4) {
+      // A tetrahedral piece already has the positive degree-two rule; avoid four redundant fans.
+      BLTetrahedron t;
