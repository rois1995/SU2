+bool SplitSurfaceStrip(const Patch& old,Edge edge,Node point,const std::vector<std::pair<Id,Node>>& moves,
+                       Id first,const PlanarReference& reference,Patch& fresh,std::string& reason,KernelStats* stats) {
+  try {
