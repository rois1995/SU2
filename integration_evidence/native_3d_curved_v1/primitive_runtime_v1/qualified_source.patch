+CSimplexMesh PrimitiveMesh(bool sphere,bool tilted) {
+  CSimplexMesh mesh;mesh.nDim=3;
+  auto add=[&](Point p){const auto id=mesh.GetnPoint();mesh.coord.insert(mesh.coord.end(),{p.x,p.y,p.z});return id;};
