+      for(int i=0;i<8;++i){const auto a=i*std::acos(-1.)/4;add({origin.x+std::cos(a)*u.x+std::sin(a)*v.x+level*axis.x,origin.y+std::cos(a)*u.y+std::sin(a)*v.y+level*axis.y,origin.z+std::cos(a)*u.z+std::sin(a)*v.z+level*axis.z});}
