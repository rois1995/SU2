+        <<",\"reference_published\":"<<(published_any ? "true" : "false")
+        <<",\"deadline_valid\":"<<(late_any ? "false" : "true")<<"}\n";}
+      return world.rank!=0;  // One-rank refusal must stop all ranks before the pointer/reference publication.
+    }
