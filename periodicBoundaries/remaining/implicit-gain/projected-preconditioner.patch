 };
 
+/*! \brief Match K = P A P + I-P with the inverse approximation P B P + I-P. */
+template <class ScalarType>
+class CPeriodicPreconditioner final : public CPreconditioner<ScalarType> {
+ private:
+  std::unique_ptr<CPreconditioner<ScalarType>> preconditioner;
+  CSysMatrix<ScalarType>& matrix;
+  CGeometry* geometry;
+  const CConfig* config;
+
+ public:
+  CPeriodicPreconditioner(CPreconditioner<ScalarType>* prec, CSysMatrix<ScalarType>& mat, CGeometry* geo,
+                          const CConfig* cfg)
+      : preconditioner(prec), matrix(mat), geometry(geo), config(cfg) {}
+
+  void Build() override { preconditioner->Build(); }
+
+  void operator()(const CSysVector<ScalarType>& u, CSysVector<ScalarType>& v) const override {
+    matrix.ApplyPeriodicPreconditioner(u, v, geometry, config,
+                                       [&](const auto& input, auto& output) { (*preconditioner)(input, output); });
+  }
+};
+
 template <class ScalarType>
 CPreconditioner<ScalarType>* CPreconditioner<ScalarType>::Create(ENUM_LINEAR_SOLVER_PREC kind,
                                                                  CSysMatrix<ScalarType>& jacobian, CGeometry* geometry,
@@ -443,6 +466,9 @@ CPreconditioner<ScalarType>* CPreconditioner<ScalarType>::Create(ENUM_LINEAR_SOL
       break;
   }
 
+  if (prec && jacobian.HasPeriodicProjection() && config->GetnMarker_Periodic() && !prec->IsIdentity())
+    prec = new CPeriodicPreconditioner<ScalarType>(prec, jacobian, geometry, config);
+
   return prec;
 }
 
diff --git a/Common/include/linear_algebra/CSysMatrix.hpp b/Common/include/linear_algebra/CSysMatrix.hpp
index dc621086b7..748c48f907 100644
--- a/Common/include/linear_algebra/CSysMatrix.hpp
+++ b/Common/include/linear_algebra/CSysMatrix.hpp
@@ -711,6 +711,19 @@ class CSysMatrix {
   void SetPeriodicProjection(int vectorIndex) { periodicVectorIndex = vectorIndex; }
   bool HasPeriodicProjection() const { return periodicVectorIndex >= -1; }
 
+  /*! \brief Preserve the constrained and complementary subspaces when preconditioning. */
+  template <class Apply>
+  void ApplyPeriodicPreconditioner(const CSysVector<ScalarType>& u, CSysVector<ScalarType>& v, CGeometry* geometry,
+                                   const CConfig* config, Apply&& apply) const {
+    if (projectedInput.GetLocSize() != u.GetLocSize()) {
+      SU2_OMP_SAFE_GLOBAL_ACCESS(projectedInput.Initialize(u.GetNBlk(), u.GetNBlkDomain(), u.GetNVar());)
+    }
+    ProjectPeriodic(u, projectedInput, geometry, config);
+    apply(projectedInput, v);
+    ProjectPeriodic(v, v, geometry, config);
+    v += u - projectedInput;
+  }
+
   /*!
    * \brief Constructor of the class.
    */
